# ============================================================
# 复制为 .env 后按需修改（本地开发默认值均可直接使用）
# ============================================================

# 数据库：默认 SQLite（本地）；生产填 Neon Postgres 连接串
# DATABASE_URL=postgresql://user:pass@ep-xxx.aws.neon.tech/growth_intel?sslmode=require
DATABASE_URL=sqlite:///./growth.db

# DeepSeek 策略报告（留空则前端报告页自动降级为本地模板）
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 前端跨域：本地默认放行所有来源；生产填 Vercel 域名
# FRONTEND_ORIGIN=https://growth-intel.vercel.app
FRONTEND_ORIGIN=*

# 数据范围（seed_data.py 灌数时使用）
SEED_START_DATE=2026-02-01
SEED_END_DATE=2026-07-31
SEED_N_USERS=15000
